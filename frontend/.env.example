# Copy to .env.local and fill in. `.env.local` is gitignored via `*.local`.

# CARTO Basemaps API key. Required — without it the basemap renders with an
# "API KEY REQUIRED" watermark. Request one (free, email only, no account) at
# https://carto.com/basemaps/apikey/ — 5M tile requests/month on the
# non-commercial tier. Baked into the client bundle at build time, so also set
# it as a Vercel project env var for deploys.
VITE_CARTO_KEY=

# Base URL of the DarkFinder API. Defaults to http://localhost:8000/api/v1 when
# unset, so local dev needs nothing here. Set in Vercel to the Railway URL.
VITE_API_BASE=
